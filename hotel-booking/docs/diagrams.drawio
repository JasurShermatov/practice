<mxfile host="app.diagrams.net" type="device" version="24.0.0">
  <diagram id="p05-context-map" name="Context map">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Hotel context map (P05)&lt;/b&gt; - four bounded contexts; every arrow starts at Reservations" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ctx-rooms" value="&lt;b&gt;Rooms (Inventory)&lt;/b&gt;&lt;br&gt;keeps: rooms, type, nightly price&lt;br&gt;status: in / out of service&lt;br&gt;owns: what is on sale, prices" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#424242;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="90" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ctx-payments" value="&lt;b&gt;Payments&lt;/b&gt;&lt;br&gt;keeps: deposits&lt;br&gt;status: Paid / Declined&lt;br&gt;owns: money rules" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#424242;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="90" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ctx-reservations" value="&lt;b&gt;Reservations&lt;/b&gt;&lt;br&gt;keeps: guests, stays, reservations (R101)&lt;br&gt;status: Confirmed / Cancelled&lt;br&gt;owns: the booking rule" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C8E6C9;strokeColor=#2E7D32;strokeWidth=2;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="420" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="ctx-notifications" value="&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;keeps: messages, channel (email/SMS)&lt;br&gt;status: Sent / Failed&lt;br&gt;owns: telling the guest" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#424242;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="420" width="300" height="120" as="geometry" />
        </mxCell>
        <mxCell id="arrow-rooms" value="Asks: which rooms exist?" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#212121;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx-reservations" target="ctx-rooms">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-payments" value="Asks: take a deposit (P17)" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#212121;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx-reservations" target="ctx-payments">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="arrow-notifications" value="Announces: ReservationConfirmed" style="endArrow=block;endFill=1;html=1;rounded=0;dashed=1;dashPattern=1 4;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;fontSize=12;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="ctx-reservations" target="ctx-notifications">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;White box: a business area (bounded context).&lt;br&gt;Green box: the context that owns the booking rule.&lt;br&gt;Solid arrow: a question; the caller waits for the answer.&lt;br&gt;Green dotted arrow: an event (&amp;quot;this happened&amp;quot;); the sender does not wait." style="text;html=1;align=left;verticalAlign=top;fontSize=12;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="590" width="560" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="p06-modules" name="Modules">

        <mxCell id="uses-rooms" value="Uses" style="endArrow=open;endFill=0;dashed=1;html=1;rounded=0;fontSize=12;labelBackgroundColor=#FFFFFF;strokeColor=#212121;" edge="1" parent="1" source="mod-reservations" target="c-rooms">
